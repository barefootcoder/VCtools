#! /bin/bash -e

function die
{
	echo "${0##*/}: $@" >&2
	exit 1
}

vctoolsdir=${0%bin/*}
vctoolsdir=${vctoolsdir%/}
vctoolsdir=${vctoolsdir:-$PWD}
[[ -d $vctoolsdir ]] || die "cannot determine VCtools directory"
# save these so they can be restored later
export PATH_WITHOUT_VC=$PATH
export PERL_LOCAL_LIB_ROOT_WITHOUT_VC=$PERL_LOCAL_LIB_ROOT
export PERL5LIB_WITHOUT_VC=$PERL5LIB
export PERL_MM_OPT_WITHOUT_VC=$PERL_MM_OPT
export PERL_MB_OPT_WITHOUT_VC=$PERL_MB_OPT
# get our env focussed on our extlib/ and exclude any other locations
export PERL_LOCAL_LIB_ROOT=${VCTOOLS_EXTLIB_DIR:-$vctoolsdir/extlib}
export PERL5LIB=$PERL_LOCAL_LIB_ROOT
export PERL_MM_OPT=
export PERL_MB_OPT=
export PERLBREW_ROOT=$PERL_LOCAL_LIB_ROOT/perlbrew

# set vars for our necessary locations
perlbrew=$PERLBREW_ROOT/bin/perlbrew
cpanm=$PERLBREW_ROOT/bin/cpanm
cpm=$PERLBREW_ROOT/bin/cpm
perlver=5.14.4
# cpm 0.999+ requires perl 5.24; never bump this past what $perlver can run
cpmver=0.998003
cpm_url=https://raw.githubusercontent.com/skaji/cpm/$cpmver/cpm

# extlib update tracking — keep in sync with App::VC::Config::EXTLIB_UPDATE_REQUEST
extlib_update_request=$vctoolsdir/share/build/update-request
vctools_conf_dir=${HOME}/.vctools
last_updated_extlib=$vctools_conf_dir/last-updated.extlib


function download
{
	# try `curl` first; fall back to `wget`, then `fetch` as a last resort
	if type -t curl >/dev/null
	then
		curl -fsSL "$1"
	elif type -t wget >/dev/null
	then
		wget -qO - "$1"
	elif type -t fetch >/dev/null
	then
		fetch -qo- "$1"
	else
		die "cannot figure out a way to download $1"
	fi
}

function cpm-is-pinned-version
{
	# don't run `cpm` to ask: a too-new one won't even compile under our perl
	[[ -r $cpm ]] && grep -q "\$VERSION='$cpmver'" $cpm
}

function have-perlbrew
{
	[[ -x $perlbrew && -d $PERLBREW_ROOT/perls/perl-$perlver ]]
}

# the fallback here mirrors the one in the BEGIN block of `bin/vc`
function perl-run
{
	if have-perlbrew
	then
		$perlbrew --quiet exec --with $perlver "$@"
	else
		"$@"
	fi
}

function perl-exec
{
	if have-perlbrew
	then
		exec $perlbrew --quiet exec --with $perlver "$@"
	else
		exec "$@"
	fi
}

function set_env
{
	have-perlbrew || [[ -d $PERL_LOCAL_LIB_ROOT/lib/perl5 ]] || die "not enough parts installed; re-run without args"
	# Save the path, then clear env vars that were initialized at the top of the script.  This
	# prevents local::lib from seeing them and creating duplicated entries in PERL_LOCAL_LIB_ROOT,
	# which breaks cpanm's internal (fat-packed) local::lib v2.000015.
	local _plr=$PERL_LOCAL_LIB_ROOT
	unset PERL_LOCAL_LIB_ROOT PERL5LIB PERL_MM_OPT PERL_MB_OPT
	eval $(perl-run perl -Mlocal::lib=$_plr,--no-create,--shelltype,bourne)
}


if [[ $1 == "RUNVC" ]]
then

	shift
	set_env
	perl-exec $vctoolsdir/bin/vc NORESPAWN "$@"

elif [[ $1 == "RUN" ]]
then

	shift
	set_env
	perl-exec "$@"

elif [[ $1 == "INSTALL" ]]
then

	# Assume nothing (well, except bash, I suppose).  Whatever we can't find, build.
	cd $vctoolsdir

	# Install perlbrew if necessary.
	if [[ ! -r $perlbrew ]]
	then
		download https://install.perlbrew.pl | bash
	fi

	# Install cpanm if necessary.
	if [[ ! -r $cpanm ]]
	then
		$perlbrew install-cpanm
	fi

	# Install cpm if necessary (or replace one at the wrong version).
	if ! cpm-is-pinned-version
	then
		download $cpm_url >$cpm.new
		chmod +x $cpm.new
		mv $cpm.new $cpm
	fi

	# Install base perl if necessary.
	if [[ ! $($perlbrew list) ]]
	then
		$perlbrew install -n -j 5 --noman -D optimize=-O1 $perlver
	fi
	# everything below must run under the perlbrew perl, so don't let perl-run fall back here
	have-perlbrew || die "perl $perlver failed to install"

	# Install a very few necessary modules into the base perl lib dirs.
	# Don't have to check if these are there or not, as `cpanm` will just DTRT.
	# Note that we use `cpanm` here because `cpm` would put them in the wrong place.
	perl-run cpanm -nq local::lib Carton
	# Now install all our required modules.
	perl-run cpm install -L $PERL_LOCAL_LIB_ROOT

	# Record that extlib was updated, so `vc self-upgrade` knows not to redo it.
	# Mirrors the path used by App::VC::Config->config_file('last-updated.extlib').
	mkdir -p $vctools_conf_dir
	date +%s > $last_updated_extlib

else

	ME=${0##*/}
	echo "usage: $ME INSTALL" >&2
	echo "       $ME RUN cmd [arg ...]" >&2
	echo "       $ME RUNVC cmd [arg ...]" >&2

fi
